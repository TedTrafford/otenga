# ── Email / SMTP ──────────────────────────────────────────────────────────────
# Gmail SMTP (requires a Gmail App Password – see instructions below)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-gmail@gmail.com
SMTP_PASSWORD=your-16-char-app-password
SMTP_FROM_EMAIL=your-gmail@gmail.com
