# The URL users use to reach the frontend (used in verification links)
APP_BASE_URL=http://localhost:5173

# ─────────────────────────────────────────────────────────────────────────────
# HOW TO CREATE A GMAIL APP PASSWORD
# ─────────────────────────────────────────────────────────────────────────────
# 1. Go to https://myaccount.google.com/security
# 2. Enable 2-Step Verification if not already on.
# 3. Go to https://myaccount.google.com/apppasswords
# 4. Select app: "Mail", device: "Other (Custom name)" → type "Otenga"
# 5. Click Generate — copy the 16-character password (no spaces).
# 6. Paste it as SMTP_PASSWORD above.
#
# NOTE: Leave SMTP_HOST blank to print verification links to the console
#       instead of sending email (useful for local development).
# ─────────────────────────────────────────────────────────────────────────────
