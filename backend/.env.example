# ── Otenga BI Platform — Backend Environment ─────────────────────────────────
# Copy this file to .env and fill in your real values.
# NEVER commit the real .env file to version control.

# JWT secret – use a long random string in production
SECRET_KEY=change-me-in-production

# ── Data database (MySQL) ─────────────────────────────────────────────────────
MPESA_DB_HOST=
MPESA_DB_PORT=3306
MPESA_DB_USER=
MPESA_DB_PASSWORD=
MPESA_DB_NAME=

# ── Email / SMTP ──────────────────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=Otenga BI Platform

# The URL users use to reach the frontend (used in email verification links)
APP_BASE_URL=http://localhost:5173
