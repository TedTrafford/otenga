# ── Root environment — copy to .env and fill in real values ──────────────────
# NEVER commit the real .env file to version control.

MPESA_DB_HOST=
MPESA_DB_PORT=3306
MPESA_DB_NAME=
MPESA_DB_USER=
MPESA_DB_PASSWORD=

# Laravel SSO — set these to enable single-sign-on with the Laravel app
# LARAVEL_JWT_SECRET = the jwt.secret value from the Laravel app's .env
# LARAVEL_APP_URL    = the URL users visit to log in (redirects back here with ?token=)
LARAVEL_JWT_SECRET=
LARAVEL_APP_URL=
